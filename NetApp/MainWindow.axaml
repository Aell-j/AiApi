<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="600"
        x:Class="NetApp.MainWindow"
        Title="NOTE — AI Analysis"
        Width="560"
        Height="600"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFFBEF"
        RequestedThemeVariant="Light">
    
    <Border Background="#FFFFFF"
            BorderBrush="#EAE7DF"
            BorderThickness="1"
            CornerRadius="18"
            Margin="8">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <Border Grid.Row="0"
                    Background="#FFFDF7"
                    BorderBrush="#F0EBDD"
                    BorderThickness="0,0,0,1"
                    CornerRadius="17,17,0,0"
                    Padding="22,18">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="#FFF0B5"
                            VerticalAlignment="Center">

                        <TextBlock Text="✦"
                                   FontSize="27"
                                   Foreground="#9A6B00"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="TitleText"
                                   Text="AI Analysis"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">

                            <Border Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    Background="#40A879"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="Помощник для твоих заметок"
                                       FontSize="12"
                                       Foreground="#8586A5"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="ToggleButton"
                            Click="ToogleButton_Click"
                            Grid.Column="2"
                            Content="×"
                            Width="36"
                            Height="36"
                            FontSize="23"
                            Background="Transparent"
                            Foreground="#8586A5"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Закрыть или свернуть панель"/>
                </Grid>
            </Border>
            
            <Grid x:Name="ContentPanel"
                  Grid.Row="1"
                  RowDefinitions="Auto,*"
                  Margin="22,20,22,14"
                  RowSpacing="16">

                <StackPanel Grid.Row="0"
                            Spacing="7">

                    <TextBlock Text="АНАЛИЗ ЗАМЕТКИ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#A18B51"
                               />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#FFFEFB"
                        BorderBrush="#EAE7DF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="15">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="12">

                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto">

                            <TextBlock Text="РЕЗУЛЬТАТ"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8586A5"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Background="#FFF0B5"
                                    CornerRadius="7"
                                    Padding="8,4">

                                <TextBlock Text="AI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#806000"/>
                            </Border>
                        </Grid>

                        <TextBox x:Name="ResponseTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="14"
                                 Foreground="#39384E"
                                 Watermark="Ожидание результата..."/>
                    </Grid>
                </Border>
            </Grid>
            
            <Border Grid.Row="2"
                    Background="#FFFDF7"
                    BorderBrush="#F0EBDD"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,17,17"
                    Padding="22,16">

                <StackPanel Spacing="12">

                    <Button x:Name="GenerateButton"
                            Click="GetButton_Click"
                            Content="✦   Сгенерировать анализ"
                            Height="48"
                            Background="#FFC928"
                            Foreground="#202238"
                            FontWeight="SemiBold"
                            BorderBrush="#EAE7DF"
                            BorderThickness="0"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>